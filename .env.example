# Leave unset for the latest stable release, or use the exact GitHub Release tag.
# APTABASE_IMAGE_TAG=v1.2.3
# Local port used by the host's HTTPS reverse proxy.
# APTABASE_PORT=8080

BASE_URL=https://analytics.example.com
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Generate each database password separately with: openssl rand -hex 32
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=

# Optional: leave SMTP_HOST empty to log notifications without sending email.
# If enabled, set SMTP_FROM_ADDRESS and use port 587 for STARTTLS or 465 for TLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_ADDRESS=
SMTP_USERNAME=
# Use single quotes around a password containing dollar signs to prevent interpolation.
SMTP_PASSWORD=

# Optional: configure both values for each OAuth provider you enable.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
